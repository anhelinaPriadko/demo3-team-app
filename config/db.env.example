
# ==========================================================
# GENERAL
# ==========================================================

PROJECT_ID="demo3-team1"
GCP_REGION="europe-west3"
GCP_ZONE="europe-west3-a"

OS_VERSION="24.04"
PG_VERSION="16"

# ==========================================================
# POSTGRESQL CLUSTER
# ==========================================================

PATRONI_SCOPE="demo3-postgres-ha"
PATRONI_NAMESPACE="/service/"

DB_MASTER_NAME="db-master"
DB_REPLICA_NAME="db-replica"

# Replace with the INTERNAL IPs of NEW VMs.
DB_MASTER_IP="CHANGE_ME"
DB_REPLICA_IP="CHANGE_ME"

PG_PORT="5432"
PATRONI_REST_PORT="8008"

# ==========================================================
# ETCD CLUSTER
# Three members: two DB VMs + one dedicated VM.
# ==========================================================

ETCD_MEMBER_1_NAME="db-master"
ETCD_MEMBER_2_NAME="db-replica"
ETCD_MEMBER_3_NAME="etcd-3"

ETCD_MEMBER_1_IP="CHANGE_ME"
ETCD_MEMBER_2_IP="CHANGE_ME"
ETCD_MEMBER_3_IP="CHANGE_ME"

ETCD_CLIENT_PORT="2379"
ETCD_PEER_PORT="2380"

# Use a unique token for every new cluster.
ETCD_CLUSTER_TOKEN="demo3-postgres-ha-01"

# ==========================================================
# SYNCHRONOUS REPLICATION
# ==========================================================

PATRONI_SYNCHRONOUS_MODE="true"
PATRONI_SYNCHRONOUS_MODE_STRICT="true"
PATRONI_SYNCHRONOUS_NODE_COUNT="1"

# ==========================================================
# POSTGRESQL DATA
# ==========================================================

PG_DATA_DIR="/data/postgresql/16/main"

PG_WAL_LOG_HINTS="on"
PG_DATA_CHECKSUMS="true"
PG_USE_PG_REWIND="true"

# ==========================================================
# GOOGLE CLOUD STORAGE
# ==========================================================

GCS_BUCKET="demo3-app-demo3-team1"
GCS_LOCATION="europe-west3"
GCS_BACKUP_PREFIX="backups/postgres"

# Backup retention
BACKUP_FULL_RETENTION="14"
BACKUP_FULL_RETENTION_TYPE="time"

# ==========================================================
# NETWORK
# ==========================================================

SSH_PORT="22"
ALLOW_PRIVATE_NETWORK_ONLY="true"

# ==========================================================
# NOTE:
# Passwords and private keys MUST NOT be stored here.
# Supply them through protected GitLab CI/CD variables.
# ==========================================================
