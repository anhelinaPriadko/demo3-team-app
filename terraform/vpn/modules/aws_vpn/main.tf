resource "aws_vpn_gateway" "this" {
  vpc_id          = var.vpc_id
  amazon_side_asn = var.amazon_side_asn

  tags = {
    Name = "${var.name_prefix}-vgw"
  }
}

# One customer gateway per GCP HA VPN interface

resource "aws_customer_gateway" "gcp" {
  count = length(var.gcp_gateway_ips)

  bgp_asn    = var.gcp_bgp_asn
  ip_address = var.gcp_gateway_ips[count.index]
  type       = "ipsec.1"

  tags = {
    Name = "${var.name_prefix}-gcp-if${count.index}"
  }
}

# Each connection has two tunnels, so there are four tunnels in total.
# Pre-shared keys are generated by AWS and passed to the GCP tunnels.

resource "aws_vpn_connection" "gcp" {
  count = length(var.gcp_gateway_ips)

  vpn_gateway_id      = aws_vpn_gateway.this.id
  customer_gateway_id = aws_customer_gateway.gcp[count.index].id
  type                = "ipsec.1"
  static_routes_only  = false

  tunnel1_inside_cidr = var.tunnel_inside_cidrs[count.index * 2]
  tunnel2_inside_cidr = var.tunnel_inside_cidrs[count.index * 2 + 1]

  tags = {
    Name = "${var.name_prefix}-gcp-if${count.index}"
  }
}

# Routes learned over BGP (the GCP subnets) appear in the private route table

resource "aws_vpn_gateway_route_propagation" "private" {
  vpn_gateway_id = aws_vpn_gateway.this.id
  route_table_id = var.private_route_table_id
}
