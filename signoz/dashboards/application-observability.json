          },
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {
                  "name": "timestamp",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": ""
                },
                {
                  "name": "body",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": "string"
                },
                {
                  "name": "severity_text",
                  "description": "Log level. Learn more [here](https://opentelemetry.io/docs/specs/otel/logs/data-model/#field-severitytext)",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": "string"
                },
                {
                  "name": "host.name",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment = 'demo3' AND (host.name IN ('demo3-app-1', 'demo3-app-2') OR service.name = 'demo3-java-app') AND severity_number >= 17"
                    },
                    "order": [
