{
  "spec": {
    "display": {
      "name": "Demo3: Application Observability",
      "description": "Host-level resource monitoring and system logs for demo3-app-1 and demo3-app-2, based on the current OpenTelemetry app.yaml configuration."
    },
    "variables": [],
    "panels": {
      "224df1c6-c0ec-4210-9fd3-d84448fff560": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Application System Logs",
            "description": "System journal and operating system logs from both application VMs."
          },
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {
                  "name": "timestamp",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": ""
                },
                {
                  "name": "body",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": "string"
                },
                {
                  "name": "severity_text",
                  "description": "Log level. Learn more [here](https://opentelemetry.io/docs/specs/otel/logs/data-model/#field-severitytext)",
                  "signal": "logs",
                  "fieldContext": "log",
                  "fieldDataType": "string"
                },
                {
                  "name": "host.name",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment = 'demo3' AND (host.name = 'demo3-app-1' OR host.name = 'demo3-app-2')"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "timestamp",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
