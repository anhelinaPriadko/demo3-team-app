{
  "spec": {
    "display": {
      "name": "Demo3: Patroni & etcd HA",
      "description": "Patroni leader election, etcd quorum and HA logs for demo3-db-master, demo3-db-slave and demo3-db-witness."
    },
    "variables": [],
    "panels": {
      "08141d7e-8504-4b7d-99e3-f91af5d66698": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HA Error Logs",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {
                  "name": "timestamp",
                  "fieldContext": "log",
                  "fieldDataType": "",
                  "signal": "logs"
                },
                {
                  "name": "body",
                  "fieldContext": "log",
                  "fieldDataType": "",
                  "signal": "logs"
                },
                {
                  "name": "severity_text",
                  "description": "Log level. Learn more [here](https://opentelemetry.io/docs/specs/otel/logs/data-model/#field-severitytext)",
                  "fieldContext": "log",
                  "fieldDataType": "string",
                  "signal": "logs"
                },
                {
                  "name": "host.name",
                  "signal": "",
                  "fieldContext": "",
                  "fieldDataType": ""
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment = 'demo3' AND service.name IN ('patroni', 'etcd', 'postgresql') AND severity_number >= 17"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "timestamp",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "27a40807-30e3-47a3-9abb-27d7e97ae4f6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "etcd Members Up (of 3)",
            "description": "Scrape status of etcd on master, slave and witness. Quorum needs at least 2."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "0"
              },
              "thresholds": [
                {
                  "value": 3,
                  "operator": "equal",
                  "unit": "",
                  "color": "#2BB673",
                  "format": "text"
                },
                {
                  "value": 2,
                  "operator": "equal",
                  "unit": "",
                  "color": "#F5A623",
                  "format": "text"
                },
                {
                  "value": 1,
                  "operator": "equal",
                  "unit": "",
                  "color": "#F1575F",
                  "format": "text"
                },
                {
                  "value": 0,
                  "operator": "equal",
                  "unit": "",
                  "color": "#F1575F",
                  "format": "text"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "up",
                              "temporality": "",
                              "timeAggregation": "latest",
                              "spaceAggregation": "sum",
                              "reduceTo": "last"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "deployment.environment = 'demo3' AND service.name = 'etcd'"
                          },
                          "groupBy": null,
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
