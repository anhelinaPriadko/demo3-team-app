      "80e1272c-01d9-4c05-8f07-49ab5153ee3c": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PostgreSQL Failover / Recovery Logs",
            "description": "Promotion, demotion, switchover and recovery events."
          },
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {
                  "name": "timestamp",
                  "fieldContext": "log",
