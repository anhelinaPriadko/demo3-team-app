          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "source": "",
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment = 'demo3' AND service.name IN ('postgresql', 'patroni') AND (body CONTAINS 'promot' OR body CONTAINS 'demot' OR body CONTAINS 'failover' OR body CONTAINS 'switchover' OR body CONTAINS 'acquired session lock' OR body CONTAINS 'recovery')"
